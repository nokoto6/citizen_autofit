@using System;
@using Sandbox;
@using Sandbox.UI;
@namespace Sandbox
@inherits Panel

@* A strip of colours to pick a value along by clicking or dragging, as the avatar editor's
   colour swatch picker. Also serves as a slider, with a plain strip. *@

<root>

	<div class="thumb" style="left: @(Value * Box.RectInner.Width * ScaleFromScreen)px"></div>

	<div class="swatches">
		@foreach ( var s in Swatches )
		{
			<div class="swatch" style="background-color: @s.Color.Hex"></div>
		}
	</div>

</root>

@code
{
	public readonly record struct Swatch( float Value, Color Color );

	[Parameter] public Swatch[] Swatches { get; set; } = [];
	[Parameter] public float Value { get; set; }
	/// <summary>Called with the value picked, for a caller that doesn't bind Value.</summary>
	[Parameter] public Action<float> OnPick { get; set; }

	protected override void OnMouseDown( MousePanelEvent e )
	{
		base.OnMouseDown( e );
		Pick();
	}

	protected override void OnMouseMove( MousePanelEvent e )
	{
		base.OnMouseMove( e );
		if ( HasActive ) Pick();
	}

	void Pick()
	{
		float width = Box.RectInner.Width;
		if ( width <= 0 ) return;
		Value = (MousePosition.x - Box.Padding.Left).Clamp( 0, width ) / width;
		OnPick?.Invoke( Value );
		StateHasChanged();
	}

	protected override int BuildHash() => HashCode.Combine( Value, Swatches );
}
