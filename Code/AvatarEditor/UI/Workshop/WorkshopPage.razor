@using System;
@using System.Collections.Generic;
@using System.Linq;
@using System.Threading.Tasks;
@using Sandbox;
@using Sandbox.UI;
@namespace FitAvatar

@* The avatar editor's workshop page, cut down to what a game can do: find community clothing
   and put it on. The menu's voting and reviews go through the menu's own overlays. *@

<root>

	<div class="body-left">
		<div class="title">Workshop</div>
		<div class="subtitle">Community clothing from the workshop. Click an item to put it on, click it again to take it off. On Aurora and Akira each one is refitted first, which takes a few seconds.</div>

		<FormRow Label="Search">
			<Content>
				<div class="search-row">
					<TextEntry @ref="SearchEntry" class="search" Icon="search" placeholder="Hat, jacket, a creator..." OnTextEdited=@OnSearchEdited onsubmit=@SearchNow></TextEntry>
					@if ( !string.IsNullOrEmpty( Query ) )
					{
						<div class="search-clear" tooltip="Clear" onclick=@ClearSearch><i>close</i></div>
					}
				</div>
			</Content>
		</FormRow>

		<div class="search-status">@Status</div>

		<FormRow Label="Sort">
			<Content>
				<div class="buttongroup bg-round">
					<div class="@(sort == "newest" ? "active" : "")" onclick=@(() => Sort( "newest" ))>Newest</div>
					<div class="@(sort == "popular" ? "active" : "")" onclick=@(() => Sort( "popular" ))>Popular</div>
					<div class="@(sort == "quality" ? "active" : "")" onclick=@(() => Sort( "quality" ))>Voted</div>
				</div>
			</Content>
		</FormRow>
	</div>

	<div class="body-center">

	</div>

	<div class="body-right">

		<div class="package-grid">
			@foreach ( var package in found )
			{
				var worn = loaded.TryGetValue( package.FullIdent, out var clothing ) && Manager.IsSelected( clothing );

				<div class="workshop-item @(worn ? "active" : "") @(loading.Contains( package.FullIdent ) ? "loading" : "")" tooltip="@package.Title" onclick=@(() => Wear( package ))>
					<div class="card-image" style="background-image: url( @package.Thumb )"></div>
					<div class="card-title">@package.Title</div>
				</div>
			}

			@if ( result is not null && found.Count < result.TotalCount )
			{
				<div class="workshop-more" onclick=@(() => _ = Fetch())><i>expand_more</i></div>
			}
		</div>

	</div>

</root>

@code
{
	AvatarEditManager Manager => Scene.GetAll<AvatarEditManager>().First();

	public string Query { get; set; } = "";
	string sort = "newest";
	TextEntry SearchEntry;

	// Searched as you type, a moment after the last key, like the menu's pages: a search per key
	// would flood the backend and shuffle the grid while typing.
	bool searchPending;
	RealTimeSince sinceEdited;
	const float TypingPause = 0.3f;

	// Each search gets a number; an answer to an older one that comes back late is dropped, or it
	// would mix its items into the newer results.
	int searchId;
	bool searching;

	string Status => searching && found.Count == 0 ? "Searching..."
		: result is null ? ""
		: found.Count == 0 ? (string.IsNullOrEmpty( Query ) ? "Nothing here" : $"Nothing found for \"{Query}\"")
		: $"{result.TotalCount} items" + (string.IsNullOrEmpty( Query ) ? "" : $" for \"{Query}\"");

	void OnSearchEdited( string text )
	{
		searchPending = true;
		sinceEdited = 0;
	}

	public override void Tick()
	{
		base.Tick();
		if ( searchPending && sinceEdited >= TypingPause ) SearchNow();
	}

	void SearchNow()
	{
		searchPending = false;
		string text = (SearchEntry?.Text ?? Query ?? "").Trim();
		if ( text == Query && result is not null ) return;
		Query = text;
		Search();
	}

	void ClearSearch()
	{
		if ( SearchEntry is not null ) SearchEntry.Text = "";
		searchPending = false;
		Query = "";
		Search();
	}
	Package.FindResult result;
	readonly List<Package> found = new();
	readonly Dictionary<string, Clothing> loaded = new();
	readonly HashSet<string> loading = new();

	protected override void OnAfterTreeRender( bool firstTime )
	{
		base.OnAfterTreeRender( firstTime );
		if ( firstTime ) Search();
	}

	void Sort( string by )
	{
		sort = by;
		Search();
	}

	void Search()
	{
		found.Clear();
		result = null;
		searchId++;
		_ = Fetch();
	}

	async Task Fetch()
	{
		int mine = searchId;
		searching = true;
		StateHasChanged();
		var query = $"type:clothing sort:{sort} {Query}".Trim();
		var answer = await Package.FindAsync( query, 60, found.Count );
		if ( mine != searchId ) return;
		searching = false;
		result = answer;
		if ( answer?.Packages != null ) found.AddRange( answer.Packages.Where( x => found.All( y => y.FullIdent != x.FullIdent ) ) );
		StateHasChanged();
	}

	async void Wear( Package package )
	{
		if ( loaded.TryGetValue( package.FullIdent, out var known ) )
		{
			Manager.OnClothingToggle( known );
			StateHasChanged();
			return;
		}

		if ( !loading.Add( package.FullIdent ) ) return;
		StateHasChanged();
		var clothing = await Manager.WearPackageAsync( package );
		loading.Remove( package.FullIdent );
		if ( clothing.IsValid() ) loaded[package.FullIdent] = clothing;
		StateHasChanged();
	}

	protected override int BuildHash() => HashCode.Combine( found.Count, loading.Count, loaded.Count, sort, Manager?.OutfitHash, Query, searching, result?.TotalCount );
}
