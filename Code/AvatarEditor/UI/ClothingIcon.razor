@using System;
@using System.Linq;
@using System.Collections.Generic;
@using System.Threading.Tasks;
@using Sandbox;
@using Sandbox.UI;
@namespace FitAvatar
@inherits Panel

<root>
    <div class="avatar" style="background-image: url( @Icon?.Trim('/') );"></div>
</root>

@code
{
    [Parameter] public string Icon { get; set; }

    protected override int BuildHash() => System.HashCode.Combine(Icon);
}
