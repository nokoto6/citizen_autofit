@using System;
@using System.Linq;
@using System.Collections.Generic;
@using System.Threading.Tasks;
@using Sandbox;
@using Sandbox.UI;

@namespace FitAvatar
@inherits Panel

<root>

    @if ( Clothing.AllowTintSelect )
    {
        @* Hair can be dyed, as in Protect The House's barber: the dye's colour, the strip below its shade. *@
        @if ( AvatarEditManager.IsDyeable( Clothing ) )
        {
            var dye = Manager.GetDye( Clothing );

            <div class="dyes">
                <div class="dye natural @(dye < 0 ? "active" : "")" tooltip="Natural" style="background-color: @Clothing.TintSelection.Evaluate( 0.6f ).Hex" onclick=@(() => Manager.SetDye( Clothing, -1 ))></div>
                @for ( int i = 0; i < AvatarEditManager.DyePalette.Length; i++ )
                {
                    var index = i;
                    var (name, color) = AvatarEditManager.DyePalette[i];
                    <div class="dye @(dye == index ? "active" : "")" tooltip="@name" style="background-color: @FitDresser.Dyed( color, 0.4f ).Hex" onclick=@(() => Manager.SetDye( Clothing, index ))></div>
                }
            </div>
        }

        <ColorSwatchPicker Value:bind="@TintValue" Swatches="@GetSwatches()"></ColorSwatchPicker>
    }

</root>

@code
{
    [Property] public Clothing Clothing { get; set; }

    AvatarEditManager Manager => Scene.GetAll<AvatarEditManager>().First();

    protected override int BuildHash() => System.HashCode.Combine( Clothing, Manager.GetDye( Clothing ) );

    ColorSwatch[] GetSwatches()
    {
        int squares = 36;
        List<ColorSwatch> swatches = new List<ColorSwatch>();

        for (int i = 0; i < squares; i++)
        {
            var f = (float)i / squares;
            var c = Manager.ColorAt( Clothing, f );
            swatches.Add(new ColorSwatch { Value = f, Color = c });
        }

        return swatches.ToArray();
    }

    public float TintValue
    {
        get => Manager.GetTint(Clothing);
        set => Manager.SetTint(Clothing, value );
    }

}
