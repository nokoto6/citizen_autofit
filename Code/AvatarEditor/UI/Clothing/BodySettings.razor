@using System.Threading.Tasks;
@using System;
@using System.Collections.Generic;
@using System.Linq;
@using Sandbox;
@using Sandbox.UI;
@namespace FitAvatar

<root>

    <div>
        <TextEntry placeholder="Avatar Name" Value:bind="@Manager.DisplayName"></TextEntry>
    </div>

    <FormRow Label="Model">
        <Content>
            <div class="buttongroup bg-round">
                @foreach ( var (kind, title) in AvatarEditManager.BodyChoices )
                {
                    <div class="@(Manager.Body == kind ? "active" : "")" onclick=@(() => Manager.Body = kind)>@title</div>
                }
            </div>
        </Content>
    </FormRow>

    <FormRow Label="Look">
        <Content>
            <div class="buttongroup bg-round">
                <div class="@(Manager.Toon ? "" : "active")" onclick=@(() => Manager.Toon = false)>Standard</div>
                <div class="@(Manager.Toon ? "active" : "")" onclick=@(() => Manager.Toon = true)>Toon</div>
            </div>
        </Content>
    </FormRow>

    <FormRow Label="Height">
        <Content>
            <SliderControl class="simple" Value:bind=@Manager.Height Min="@(0.0f)" Max="@(1.0f)" Step="@(0.01f)"></SliderControl>
        </Content>
    </FormRow>

    @if ( Manager.CitizenActive )
    {
        <FormRow Label="Age">
            <Content>
                <SliderControl class="simple" Value:bind=@Manager.Age Min="@(0.0f)" Max="@(1.0f)" Step="@(0.01f)"></SliderControl>
            </Content>
        </FormRow>

        <FormRow Label="Skin">
            <Content>
                <ColorSwatchPicker Value:bind="@Manager.Tint" Swatches="@GetSkinSwatches()"></ColorSwatchPicker>
            </Content>
        </FormRow>
    }
    else
    {
        <FormRow Label="Skin">
            <Content>
                <div class="skin-items">
                    @foreach( var item in Manager.HumanSkins() )
                    {
                        var c = Manager.IsSelected( item ) ? "active" : "";

                        <ClothingIcon class="@c" onclick=@( () => Clicked( item ) ) Icon=@item.Icon.Path></ClothingIcon>
                    }
                </div>
            </Content>
        </FormRow>
    }

    @if ( Manager.Body == AvatarEditManager.BodyKind.Aurora )
    {
        <FormRow Label="Eyes">
            <Content>
                <div class="eye-items">
                    <div class="eye own @(Manager.TintEyes ? "" : "active")" onclick=@(() => Manager.TintEyes = false)><i>block</i></div>
                    @foreach ( var color in EyeColors )
                    {
                        <div class="eye @(Manager.TintEyes && Manager.EyeColor == color ? "active" : "")" style="background-color: @color.Hex" onclick=@(() => Manager.EyeColor = color)></div>
                    }
                </div>
            </Content>
        </FormRow>
    }

    @* The stock editor's eye and body sliders, on the citizen as there: the eye shader and the deform volumes are its own. *@
    @if ( Manager.Body == AvatarEditManager.BodyKind.Citizen )
    {
        <FormRow Label="Eye Color">
            <Content>
                <ColorSwatchPicker Value:bind="@Manager.IrisColor" Swatches="@EyeSwatches()"></ColorSwatchPicker>
            </Content>
        </FormRow>

        <FormRow Label="Eye Alignment">
            <Content>
                <SliderControl class="simple" Value:bind="@Manager.IrisAlign" Min="@(0f)" Max="@(1f)" Step="@(0.01f)" />
            </Content>
        </FormRow>

        <FormRow Label="Neck Size">
            <Content>
                <SliderControl class="simple" Value:bind="@Manager.NeckSize" Min="@(0f)" Max="@(1f)" Step="@(0.01f)" />
            </Content>
        </FormRow>

        <FormRow Label="Waist Size">
            <Content>
                <SliderControl class="simple" Value:bind="@Manager.WaistSize" Min="@(0f)" Max="@(1f)" Step="@(0.01f)" />
            </Content>
        </FormRow>

        <FormRow Label="Chest Size">
            <Content>
                <SliderControl class="simple" Value:bind="@Manager.ChestSize" Min="@(0f)" Max="@(1f)" Step="@(0.01f)" />
            </Content>
        </FormRow>

        <FormRow Label="Head Shape">
            <Content>
                <SliderControl class="simple" Value:bind="@Manager.HeadShape" Min="@(0f)" Max="@(1f)" Step="@(0.01f)" />
            </Content>
        </FormRow>

        <FormRow Label="Nose Size">
            <Content>
                <SliderControl class="simple" Value:bind="@Manager.NoseSize" Min="@(0f)" Max="@(1f)" Step="@(0.01f)" />
            </Content>
        </FormRow>

        <FormRow Label="Chin Size">
            <Content>
                <SliderControl class="simple" Value:bind="@Manager.ChinSize" Min="@(0f)" Max="@(1f)" Step="@(0.01f)" />
            </Content>
        </FormRow>
    }

    @if (Manager.Container.Clothing.Any(x => x.Clothing?.AllowTintSelect ?? false ))
    {
        <div style="height:32px"></div>

        @foreach (var entry in Manager.Container.Clothing.ToList())
        {
            if (entry.Clothing == null) continue;
            if (!entry.Clothing.AllowTintSelect) continue;

            <FormRow Label="@entry.Clothing.Title">
                <Content>
                    <ClothingOptions Clothing="@entry.Clothing"></ClothingOptions>
                </Content>
            </FormRow>
        }
    }

    <div class="actions">
        <div class="headerbutton" onclick=@Manager.Randomize><div class="icon">casino</div><div class="title">Random</div></div>
        <div class="headerbutton" onclick=@Manager.Clear><div class="icon">delete_sweep</div><div class="title">Clear</div></div>
    </div>

</root>

@code
{
    [Parameter]
    public AvatarEditManager Manager { get; set; }

    protected override int BuildHash() => HashCode.Combine( Manager.Body, Manager.Toon, Manager.TintEyes, Manager.EyeColor, Manager.OutfitHash, Manager.IrisColor );

    static ColorSwatch[] eyeSwatches;

    // The stock eye palette, in as many steps as the skin's.
    ColorSwatch[] EyeSwatches() => eyeSwatches ??= Enumerable.Range( 0, 33 )
        .Select( i => new ColorSwatch { Value = i / 32f, Color = Dresser.EyeColorGradient.Evaluate( i / 32f ) } )
        .ToArray();

    static readonly Color[] EyeColors =
    [
        new Color( 0.34f, 0.21f, 0.11f ), new Color( 0.18f, 0.1f, 0.05f ), new Color( 0.55f, 0.4f, 0.16f ),
        new Color( 0.25f, 0.45f, 0.2f ), new Color( 0.2f, 0.42f, 0.62f ), new Color( 0.45f, 0.6f, 0.75f ),
        new Color( 0.45f, 0.25f, 0.62f ), new Color( 0.7f, 0.2f, 0.25f ), new Color( 0.5f, 0.52f, 0.55f ),
    ];

    // The tones of the body's tint lookup. The table is half the tone (the skin shader doubles it
    // over the skin's colour), so it is shown doubled. Aurora has a table of her own.
    static readonly Dictionary<bool, ColorSwatch[]> skinSwatches = new();

    ColorSwatch[] GetSkinSwatches()
    {
        bool aurora = Manager.Body == AvatarEditManager.BodyKind.Aurora;
        if ( skinSwatches.TryGetValue( aurora, out var known ) ) return known;

        var material = Material.Load( aurora ? "models/aurora/aurora_body.vmat" : "models/citizen/skin/citizen_skin01.vmat" );
        var tex = material?.GetTexture( "g_tTintLookup" );
        if ( tex is null ) return [];
        var lookup = tex.GetBitmap( 0 );

        var swatches = new List<ColorSwatch>();
        for ( int i = 0; i <= 32; i++ )
        {
            float f = i / 32f;
            var x = Math.Clamp( (int)(f * lookup.Width), 0, lookup.Width - 1 );
            var c = lookup.GetPixel( x, 8 );
            swatches.Add( new ColorSwatch { Value = f, Color = new Color( MathF.Min( 1, c.r * 2 ), MathF.Min( 1, c.g * 2 ), MathF.Min( 1, c.b * 2 ) ) } );
        }

        return skinSwatches[aurora] = swatches.ToArray();
    }

    void Clicked( Clothing x )
    {
        // don't deselect skins - they just have to choose a new one!
        if ( Manager.IsSelected(x) )
            return;

        Manager.OnClothingToggle(x);
    }
}
