@using System;
@using System.Collections.Generic;
@using System.Linq;
@using Sandbox;
@using Sandbox.UI;
@namespace Sandbox
@inherits PanelComponent

@* The avatar editor's screen, after s&box's own (see FitAvatarEditor): the body and its look on
   the left, the clothing to pick from on the right. *@

<root>

	<div class="left">

		<div class="heading">Fit Dresser</div>

		<div class="row">
			<div class="label">Body</div>
			<div class="choices">
				@foreach ( var (kind, title) in FitAvatarEditor.BodyChoices )
				{
					<div class="choice @(Editor.Body == kind ? "active" : "")" onclick=@(() => Editor.Body = kind)>@title</div>
				}
			</div>
		</div>

		<div class="row">
			<div class="label">Toon</div>
			<div class="toggle @(Editor.Toon ? "on" : "")" onclick=@(() => Editor.Toon = !Editor.Toon)>
				<div class="knob"></div>
			</div>
		</div>

		<div class="row">
			<div class="label">Height</div>
			<FitSwatches Swatches=@Track Value:bind=@Editor.Height></FitSwatches>
		</div>

		@if ( Editor.HasSkinTone )
		{
			<div class="row">
				<div class="label">Age</div>
				<FitSwatches Swatches=@Track Value:bind=@Editor.Age></FitSwatches>
			</div>

			<div class="row">
				<div class="label">Skin</div>
				<FitSwatches Swatches=@SkinTones() Value:bind=@Editor.Tint></FitSwatches>
			</div>
		}
		else
		{
			<div class="row">
				<div class="label">Skin</div>
				<div class="skins">
					@foreach ( var item in Editor.AllClothing.Where( x => x.HasHumanSkin ) )
					{
						<div class="item small @(Editor.IsSelected( item ) ? "active" : "")" tooltip=@item.Title onclick=@(() => PickSkin( item ))>
							<div class="icon" style="background-image: url( @IconOf( item ) )"></div>
						</div>
					}
				</div>
			</div>
		}

		@if ( Editor.Body == FitAvatarEditor.BodyKind.Aurora )
		{
			<div class="row">
				<div class="label">Eyes</div>
				<div class="eyes">
					<div class="eye own @(Editor.TintEyes ? "" : "active")" tooltip="Her own" onclick=@(() => Editor.TintEyes = false)>
						<i>block</i>
					</div>
					@foreach ( var color in EyeColors )
					{
						<div class="eye @(Editor.TintEyes && Editor.EyeColor == color ? "active" : "")" style="background-color: @color.Hex" onclick=@(() => Editor.EyeColor = color)></div>
					}
				</div>
			</div>
		}

		@foreach ( var entry in Editor.Outfit.Clothing.Where( x => x.Clothing?.AllowTintSelect ?? false ).ToList() )
		{
			var clothing = entry.Clothing;
			<div class="row">
				<div class="label">@clothing.Title</div>
				<FitSwatches Swatches=@TintsOf( clothing ) Value=@Editor.GetTint( clothing ) OnPick=@(( float f ) => Editor.SetTint( clothing, f ))></FitSwatches>
			</div>
		}

		<div class="buttons">
			<div class="button" onclick=@Editor.Randomize><i>casino</i>Random</div>
			<div class="button" onclick=@Editor.Clear><i>delete_sweep</i>Clear</div>
		</div>

	</div>

	<div class="right">

		<div class="tabs">
			@foreach ( var t in FitClothingGroups.Tabs )
			{
				<div class="tab @(t == tab ? "active" : "")" onclick=@(() => PickTab( t ))>@t.Title</div>
			}
		</div>

		<div class="picker">

			<div class="sections">
				@foreach ( var s in tab.Sections )
				{
					<div class="section @(s == section ? "active" : "")" onclick=@(() => PickSection( s ))>
						<i>@s.Icon</i>
						<div class="title">@s.Title</div>
					</div>
				}
			</div>

			<div class="list">

				<div class="kinds">
					<div class="kind @(kind == null ? "active" : "")" onclick=@(() => kind = null)>All</div>
					@foreach ( var k in section.Kinds )
					{
						<div class="kind @(k == kind ? "active" : "")" onclick=@(() => kind = k)>@k.Title</div>
					}
				</div>

				<div class="grid">
					@foreach ( var item in Items() )
					{
						<div class="item @(Editor.IsSelected( item ) ? "active" : "")" tooltip=@item.Title onclick=@(() => Editor.Toggle( item ))>
							@if ( string.IsNullOrEmpty( item.Icon.Path ) )
							{
								<div class="name">@item.Title</div>
							}
							else
							{
								<div class="icon" style="background-image: url( @IconOf( item ) )"></div>
							}
						</div>
					}
				</div>

			</div>

		</div>

	</div>

</root>

@code
{
	FitAvatarEditor Editor => Scene.GetAll<FitAvatarEditor>().FirstOrDefault();

	FitClothingGroups.Tab tab = FitClothingGroups.Tabs[1];
	FitClothingGroups.Section section = FitClothingGroups.Tabs[1].Sections[1];
	FitClothingGroups.Kind kind;

	void PickTab( FitClothingGroups.Tab t )
	{
		tab = t;
		PickSection( t.Sections[0] );
	}

	void PickSection( FitClothingGroups.Section s )
	{
		section = s;
		kind = null;
	}

	IEnumerable<Clothing> Items()
	{
		var categories = kind?.Categories ?? section.Categories.ToArray();
		return Editor.AllClothing.Where( x => categories.Contains( x.Category ) && !x.HasHumanSkin );
	}

	static string IconOf( Clothing item ) => item.Icon.Path?.Trim( '/' );

	// A skin is swapped, never taken off: a human always has one on.
	void PickSkin( Clothing item )
	{
		if ( !Editor.IsSelected( item ) ) Editor.Toggle( item );
	}

	static readonly FitSwatches.Swatch[] Track = Enumerable.Range( 0, 24 )
		.Select( i => new FitSwatches.Swatch( i / 23f, Color.Lerp( new Color( 0.22f, 0.24f, 0.28f ), new Color( 0.55f, 0.6f, 0.68f ), i / 23f ) ) )
		.ToArray();

	static readonly Color[] EyeColors =
	[
		new Color( 0.34f, 0.21f, 0.11f ), new Color( 0.18f, 0.1f, 0.05f ), new Color( 0.55f, 0.4f, 0.16f ),
		new Color( 0.25f, 0.45f, 0.2f ), new Color( 0.2f, 0.42f, 0.62f ), new Color( 0.45f, 0.6f, 0.75f ),
		new Color( 0.45f, 0.25f, 0.62f ), new Color( 0.7f, 0.2f, 0.25f ), new Color( 0.5f, 0.52f, 0.55f ),
	];

	// The skin's tones, read off the body's tint lookup. The table is half the tone (the shader
	// doubles it over the skin's colour), so it is shown doubled.
	Dictionary<FitAvatarEditor.BodyKind, FitSwatches.Swatch[]> tones = new();

	FitSwatches.Swatch[] SkinTones()
	{
		if ( tones.TryGetValue( Editor.Body, out var known ) ) return known;
		var material = Material.Load( Editor.Body == FitAvatarEditor.BodyKind.Aurora ? "models/aurora/aurora_body.vmat" : "models/citizen/skin/citizen_skin01.vmat" );
		var bitmap = material?.GetTexture( "g_tTintLookup" )?.GetBitmap( 0 );
		var swatches = new List<FitSwatches.Swatch>();
		for ( int i = 0; i <= 32; i++ )
		{
			float f = i / 32f;
			var c = bitmap is null ? Color.Lerp( new Color( 1f, 0.86f, 0.78f ), new Color( 0.36f, 0.22f, 0.15f ), f )
				: bitmap.GetPixel( Math.Clamp( (int)(f * bitmap.Width), 0, bitmap.Width - 1 ), bitmap.Height / 2 );
			if ( bitmap is not null ) c = new Color( MathF.Min( 1, c.r * 2 ), MathF.Min( 1, c.g * 2 ), MathF.Min( 1, c.b * 2 ) );
			swatches.Add( new FitSwatches.Swatch( f, c ) );
		}
		return tones[Editor.Body] = swatches.ToArray();
	}

	static FitSwatches.Swatch[] TintsOf( Clothing clothing ) => Enumerable.Range( 0, 32 )
		.Select( i => new FitSwatches.Swatch( i / 31f, clothing.TintSelection.Evaluate( i / 31f ) ) )
		.ToArray();

	protected override int BuildHash()
	{
		if ( Editor is not { } e ) return 0;
		var outfit = new HashCode();
		foreach ( var x in e.Outfit.Clothing ) { outfit.Add( x.Clothing ); outfit.Add( x.Tint ); }
		return HashCode.Combine( e.Body, e.Toon, e.TintEyes, e.EyeColor, tab, section, kind, outfit.ToHashCode() );
	}
}
